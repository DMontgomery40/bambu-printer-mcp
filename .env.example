# Bambu Lab printer connection
PRINTER_HOST=192.168.1.100
BAMBU_SERIAL=your_serial_number
BAMBU_TOKEN=your_access_token

# Slicer (auto-detected as bambustudio)
SLICER_PATH=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio
SLICER_PROFILE=

# Trusted ffmpeg executable used for RTSP camera snapshots
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Transport: stdio (default) or streamable-http
MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_ALLOWED_ORIGINS=http://localhost

# Optional Blender bridge
# BLENDER_MCP_BRIDGE_COMMAND=

# Accept per-call executable selectors such as slicer_path, ffmpeg_path, and
# bridge_command. Off by default; configure trusted executables above instead.
# MCP_ALLOW_BRIDGE_COMMAND_ARG remains a legacy alias for bridge_command only.
MCP_ALLOW_EXECUTABLE_ARG=false
