# Prefer the README's "Set up with your agent" request for guided installation.
# Manual reference: docs/SETUP.md; FULU slicer/bridge setup: docs/FULU.md.

# Direct LAN printer connection. Replace these values; keep this file private
# after copying it to .env. The LAN access code is not an account password.
PRINTER_HOST=192.168.1.100
BAMBU_SERIAL=your_serial_number
BAMBU_TOKEN=your_lan_access_code
# Required for slicing/printing: set the actual model, e.g. p1s, a1, h2d.
# Leave blank until confirmed. X2D supports status/slicing, not direct printing.
BAMBU_MODEL=
# NOZZLE_DIAMETER=0.4
# BED_TYPE=textured_plate

# Optional slicer; unnecessary when printing an already sliced project.
# FULU/Orca: use GUI-exported files until the CLI machine-preset gate ships.
# Recognized aliases are not proof of safe auto-slicing; see docs/FULU.md.
# Set SLICER_PATH to your installed executable when platform discovery differs.
SLICER_TYPE=bambustudio
# SLICER_PATH=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio
SLICER_PROFILE=
# BAMBU_PROFILES_ROOT=/path/to/matching/installation/resources/profiles

# Optional FULU BambuNetwork bridge; selecting a slicer does not enable this.
# Use the host binary/platform wrapper command, not the slicer GUI.
# BAMBU_NETWORK_BRIDGE_COMMAND=
# PJARCZAK_BAMBU_PLUGIN_DIR=/path/to/fulu-runtime
# BAMBU_DEV_ID=your_device_id
# BAMBU_NETWORK_CONFIG_DIR=/private/persistent/bambu-network
# BAMBU_NETWORK_COUNTRY_CODE=US
# BAMBU_NETWORK_USER_INFO=  # Sensitive runtime-compatible JSON, not a password.

# Trusted ffmpeg executable used for RTSP camera snapshots
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Transport: stdio (default) or streamable-http
MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# MCP_HTTP_ALLOWED_ORIGINS=http://localhost

# Optional standard Blender MCP integration (start its addon inside Blender).
# BLENDER_MCP_COMMAND=/absolute/path/to/uvx
# BLENDER_MCP_ARGS='["blender-mcp"]'
# BLENDER_MCP_TIMEOUT_MS=120000
# Legacy custom executable bridge:
# BLENDER_MCP_BRIDGE_COMMAND=

# Accept per-call executable selectors such as slicer_path, ffmpeg_path, and
# bridge_command. Off by default; configure trusted executables above instead.
# MCP_ALLOW_BRIDGE_COMMAND_ARG remains a legacy alias for bridge_command only.
MCP_ALLOW_EXECUTABLE_ARG=false

# Leave TEMP_DIR unset for a private OS temporary directory per server instance.
